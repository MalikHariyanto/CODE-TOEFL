{
  "name": "ruang-toefl-itp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-content.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "content:check": "node scripts/validate-content.mjs",
    "audio:build": "python3 scripts/build-audio.py",
    "inventory": "node scripts/inventory.mjs",
    "build:vercel": "node scripts/validate-content.mjs && vite build --base /"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "fake-indexeddb": "6.2.4",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
